{
  "name": "even-uber-display",
  "version": "1.0.0",
  "type": "module",
  "description": "Even Hub display app for Even Uber - ride tracking on G2 AR glasses",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -n vite,server \"npm:dev:vite\" \"npm:dev:server\" --kill-others",
    "dev:vite": "vite",
    "dev:server": "tsx watch server.ts",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "lint": "npm run type-check",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "type-check:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "terser": "^5.50.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^4.3.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@evenrealities/even_hub_sdk": "*"
  }
}
