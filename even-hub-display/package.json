{
  "name": "even-uber-display",
  "version": "1.0.0",
  "type": "module",
  "description": "Even Hub display app for Even Uber - ride tracking on G2 AR glasses",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --loader ts-node/esm server.ts\" --kill-others",
    "dev:vite": "vite",
    "dev:server": "node --loader ts-node/esm server.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "vite": "^4.3.0"
  },
  "optionalDependencies": {
    "@evenrealities/even_hub_sdk": "*"
  }
}
